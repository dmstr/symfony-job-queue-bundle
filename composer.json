{
    "name": "dmstr/symfony-job-queue-bundle",
    "description": "Persisted job tracking on top of Symfony Messenger: Job entity with status, JobQueueService for dispatch, JobMessage/JobMessageHandler for async execution.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "diemeisterei GmbH",
            "homepage": "https://diemeisterei.de"
        }
    ],
    "require": {
        "php": ">=8.5",
        "symfony/framework-bundle": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/uid": "^7.0",
        "doctrine/orm": "^3.0",
        "doctrine/doctrine-bundle": "^2.0",
        "dmstr/openapi-json-schema-bundle": "^0.4.0",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "doctrine/migrations": "^3.9",
        "doctrine/dbal": "^3.7",
        "ext-pdo_sqlite": "*",
        "api-platform/symfony": "^4.3.18",
        "api-platform/doctrine-orm": "^4.3.18",
        "symfony/security-bundle": "^7.4",
        "symfony/expression-language": "^7.4",
        "symfony/yaml": "^7.4",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "symfony/browser-kit": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Dmstr\\SymfonyJobQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmstr\\SymfonyJobQueue\\Tests\\": "tests/",
            "Dmstr\\SymfonyJobQueue\\Migrations\\": "migrations/"
        }
    }
}
